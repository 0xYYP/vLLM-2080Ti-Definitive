{%- set template_version = "qwen3.8-zh-compatible-v7" %}
{%- set image_count = namespace(value=0) %}
{%- set video_count = namespace(value=0) %}
{%- set add_vision_id = add_vision_id if add_vision_id is defined else false %}
{%- set ns_state = namespace(
    thinking=(enable_thinking is undefined or enable_thinking is true)
) %}
{%- set _reasoning_language =
    reasoning_language if reasoning_language is defined else 'zh'
%}
{%- if _reasoning_language not in ('zh', 'zh-CN', 'auto', 'en') %}
    {{- raise_exception(
        'Unsupported reasoning_language: ' ~ _reasoning_language ~
        '. Supported values are zh, zh-CN, auto, and en.'
    ) }}
{%- endif %}
{%- set _effort_raw =
    reasoning_effort
    if reasoning_effort is defined and reasoning_effort is not none
    else 'medium'
%}
{%- if _effort_raw in ('high', 'xhigh', 'max') %}
    {%- set _reasoning_effort = 'xhigh' %}
{%- elif _effort_raw in ('minimal', 'low') %}
    {%- set _reasoning_effort = 'low' %}
{%- elif _effort_raw == 'medium' %}
    {%- set _reasoning_effort = 'medium' %}
{%- elif _effort_raw == 'none' %}
    {%- set _reasoning_effort = 'none' %}
    {%- set ns_state.thinking = false %}
{%- else %}
    {{- raise_exception(
        'Unsupported reasoning_effort: ' ~ _effort_raw ~
        '. Supported values are none, minimal, low, medium, high, xhigh, and max.'
    ) }}
{%- endif %}
{%- if enable_thinking is defined and enable_thinking is false %}
    {%- set ns_state.thinking = false %}
{%- endif %}
{%- set _preserve_reasoning =
    preserve_reasoning if preserve_reasoning is defined else none
%}
{%- set _preserve_thinking_arg =
    preserve_thinking if preserve_thinking is defined else none
%}
{%- if _preserve_reasoning is not none
       and _preserve_thinking_arg is not none
       and _preserve_reasoning != _preserve_thinking_arg %}
    {{- raise_exception(
        'preserve_reasoning and preserve_thinking were both provided with conflicting values.'
    ) }}
{%- endif %}
{%- if _preserve_reasoning is not none %}
    {%- set _preserve_history = _preserve_reasoning %}
{%- elif _preserve_thinking_arg is not none %}
    {%- set _preserve_history = _preserve_thinking_arg %}
{%- else %}
    {%- set _preserve_history = true %}
{%- endif %}
{%- if tools is defined and tools is not none and tools %}
    {%- if tools is string or tools is mapping or tools is not iterable %}
        {{- raise_exception('tools must be an iterable list of tool definitions.') }}
    {%- endif %}
    {%- set _has_tools = true %}
{%- else %}
    {%- set _has_tools = false %}
{%- endif %}
{%- set _tool_format = tool_call_format if tool_call_format is defined else 'xml' %}
{%- if _tool_format != 'xml' %}
    {{- raise_exception(
        'This template emits Qwen native XML tool calls only. '
        'Use a separate JSON template and matching parser for tool_call_format=json.'
    ) }}
{%- endif %}
{%- macro render_content(content, do_vision_count, is_system_content=false, skip_thinking=false) %}
    {%- if content is string %}
        {{- content }}
    {%- elif content is iterable and content is not mapping %}
        {%- for item in content %}
            {%- if item is not mapping %}
                {{- raise_exception('Content-list items must be mappings.') }}
            {%- endif %}
            {%- set _item_type = item.type if 'type' in item else none %}
            {%- if 'image' in item or 'image_url' in item or _item_type == 'image' %}
                {%- if is_system_content %}
                    {{- raise_exception('System message cannot contain images.') }}
                {%- endif %}
                {%- if do_vision_count %}
                    {%- set image_count.value = image_count.value + 1 %}
                {%- endif %}
                {%- if add_vision_id %}
                    {{- 'Picture ' ~ image_count.value ~ ': ' }}
                {%- endif %}
                {{- '<|vision_start|><|image_pad|><|vision_end|>' }}
            {%- elif 'video' in item or _item_type == 'video' %}
                {%- if is_system_content %}
                    {{- raise_exception('System message cannot contain videos.') }}
                {%- endif %}
                {%- if do_vision_count %}
                    {%- set video_count.value = video_count.value + 1 %}
                {%- endif %}
                {%- if add_vision_id %}
                    {{- 'Video ' ~ video_count.value ~ ': ' }}
                {%- endif %}
                {{- '<|vision_start|><|video_pad|><|vision_end|>' }}
            {%- elif 'text' in item %}
                {{- item.text }}
            {%- elif skip_thinking and _item_type in ('thinking', 'redacted_thinking') %}
                {{- '' }}
            {%- else %}
                {{- raise_exception('Unexpected item type in content.') }}
            {%- endif %}
        {%- endfor %}
    {%- elif content is none or content is undefined %}
        {{- '' }}
    {%- else %}
        {{- raise_exception('Unexpected content type.') }}
    {%- endif %}
{%- endmacro %}
{%- if not messages %}
    {{- raise_exception('No messages provided.') }}
{%- endif %}
{#- The last control tag in chronological system/user input wins. -#}
{%- for message in messages %}
    {%- if message.role == 'system'
           or message.role == 'developer'
           or message.role == 'user' %}
        {%- if message.content is string %}
            {%- if '<|think_off|>' in message.content %}
                {%- set ns_state.thinking = false %}
            {%- elif '<|think_on|>' in message.content %}
                {%- set ns_state.thinking = true %}
            {%- endif %}
        {%- elif message.content is iterable and message.content is not mapping %}
            {%- for item in message.content %}
                {%- if item is mapping and 'text' in item and item.text is string %}
                    {%- if '<|think_off|>' in item.text %}
                        {%- set ns_state.thinking = false %}
                    {%- elif '<|think_on|>' in item.text %}
                        {%- set ns_state.thinking = true %}
                    {%- endif %}
                {%- endif %}
            {%- endfor %}
        {%- endif %}
    {%- endif %}
{%- endfor %}
{#- Explicit API controls take precedence over inline convenience tags. -#}
{%- if enable_thinking is defined and enable_thinking is false %}
    {%- set ns_state.thinking = false %}
{%- endif %}
{%- if _reasoning_effort == 'none' %}
    {%- set ns_state.thinking = false %}
{%- endif %}
{%- set reasoning_instructions = '' %}
{%- if ns_state.thinking %}
    {%- if _reasoning_language in ('zh', 'zh-CN') %}
        {%- if _reasoning_effort == 'xhigh' %}
            {%- set reasoning_instructions =
                '思考强度设置为 xhigh。请仔细分析任务，验证关键假设，考虑合理的替代方案，并优先保证正确性、一致性和最终回答的清晰度。'
            %}
        {%- elif _reasoning_effort == 'medium' %}
            {%- set reasoning_instructions =
                '思考强度设置为 medium。请在回答前适度思考，把握关键因素，确保答案准确、完整、条理清晰。'
            %}
        {%- elif _reasoning_effort == 'low' %}
            {%- set reasoning_instructions =
                '思考强度设置为 low。请保持思考简短且聚焦，直接得出结论，避免不必要的展开。'
            %}
        {%- endif %}
    {%- else %}
        {%- if _reasoning_effort == 'xhigh' %}
            {%- set reasoning_instructions =
                'Reasoning effort is set to xhigh. Please think carefully through the task, validate key assumptions, consider plausible alternatives, and prioritize correctness, consistency, and clarity in the final answer.'
            %}
        {%- elif _reasoning_effort == 'medium' %}
            {%- set reasoning_instructions =
                'Reasoning effort is set to medium. Think moderately before answering: weigh the key factors, keep the answer accurate and complete, and present it clearly.'
            %}
        {%- elif _reasoning_effort == 'low' %}
            {%- set reasoning_instructions =
                'Reasoning effort is set to low. Keep your thinking brief and focused, moving directly to the conclusion without unnecessary elaboration.'
            %}
        {%- endif %}
    {%- endif %}
{%- endif %}
{%- set _language_instruction = '' %}
{%- if _reasoning_language in ('zh', 'zh-CN') %}
    {%- set _language_instruction =
        '自然语言思考和最终回答默认使用简体中文；代码、命令、路径、标识符、JSON、XML 标签、函数名、参数名和专有名词保持原文。直接处理用户的任务，不提及语言规则、系统提示或提示内容；除非用户明确要求其他语言。'
    %}
    {%- set _tool_followup_seed =
        '好的，输出拿到了，我先梳理一下这些结果。'
    %}
{%- else %}
    {%- set _language_instruction = '' %}
    {%- set _tool_followup_seed = '' %}
{%- endif %}
{#- Merge only leading system/developer messages; reject mid-history injection. -#}
{%- set head = namespace(count=0, seen_non_system=false) %}
{%- for message in messages %}
    {%- if message.role == 'system' or message.role == 'developer' %}
        {%- if head.seen_non_system %}
            {{- raise_exception('System and developer messages must appear before user, assistant, and tool messages.') }}
        {%- endif %}
        {%- set head.count = head.count + 1 %}
    {%- else %}
        {%- set head.seen_non_system = true %}
    {%- endif %}
{%- endfor %}
{%- set system_state = namespace(content='') %}
{%- for message in messages[:head.count] %}
    {%- set _part = render_content(message.content, false, true) | trim %}
    {%- set _part = _part.split('<|think_off|>') | join('') | trim %}
    {%- set _part = _part.split('<|think_on|>') | join('') | trim %}
    {%- if _part %}
        {%- if system_state.content %}
            {%- set system_state.content = system_state.content ~ '\n\n' ~ _part %}
        {%- else %}
            {%- set system_state.content = _part %}
        {%- endif %}
    {%- endif %}
{%- endfor %}
{%- set _system_content = system_state.content %}
{%- set _msgs = messages[head.count:] %}
{%- if _has_tools %}
    {{- '<|im_start|>system\n' }}
    {%- if reasoning_instructions %}
        {{- reasoning_instructions + '\n\n' }}
    {%- endif %}
    {{- "# Tools\n\nYou have access to the following functions:\n\n<tools>" }}
    {%- for tool in tools %}
        {{- "\n" }}
        {{- tool | tojson }}
    {%- endfor %}
    {{- "\n</tools>" }}
    {{- '\n\nIf you choose to call a function ONLY reply in the following format with NO suffix:\n\n<tool_call>\n<function=example_function_name>\n<parameter=example_parameter_1>\nvalue_1\n</parameter>\n<parameter=example_parameter_2>\nThis is the value for the second parameter\nthat can span\nmultiple lines\n</parameter>\n</function>\n</tool_call>\n\n<IMPORTANT>\nReminder:\n- Function calls MUST follow the specified format: an inner <function=...></function> block must be nested within <tool_call></tool_call> XML tags\n- Required parameters MUST be specified\n- You may provide optional reasoning for your function call in natural language BEFORE the function call, but NOT after\n- If there is no function call available, answer the question like normal with your current knowledge and do not tell the user about function calls\n</IMPORTANT>' }}
    {%- if _system_content %}
        {%- set content = _system_content %}
        {%- if content %}
            {{- '\n\n' + content }}
        {%- endif %}
    {%- endif %}
    {%- if _language_instruction %}
        {{- '\n\n' + _language_instruction }}
    {%- endif %}
    {{- '<|im_end|>\n' }}
{%- else %}
    {%- if reasoning_instructions or _system_content or _language_instruction %}
        {{- '<|im_start|>system\n' }}
        {%- if reasoning_instructions %}
            {{- reasoning_instructions }}
        {%- endif %}
        {%- if _system_content %}
            {{- '\n\n' if reasoning_instructions else '' }}
            {{- _system_content }}
        {%- endif %}
        {%- if _language_instruction %}
            {{- '\n\n' if reasoning_instructions or _system_content else '' }}
            {{- _language_instruction }}
        {%- endif %}
        {{- '<|im_end|>\n' }}
    {%- endif %}
{%- endif %}
{%- set ns = namespace(multi_step_tool=true, last_query_index=_msgs | length - 1) %}
{%- for message in _msgs[::-1] %}
    {%- set index = (_msgs | length - 1) - loop.index0 %}
    {%- if ns.multi_step_tool and message.role == "user" %}
        {%- set content = render_content(message.content, false)|trim %}
        {%- if not(content.startswith('<tool_response>') and content.endswith('</tool_response>')) %}
            {%- set ns.multi_step_tool = false %}
            {%- set ns.last_query_index = index %}
        {%- endif %}
    {%- endif %}
{%- endfor %}
{%- if ns.multi_step_tool %}
    {{- raise_exception('No user query found in messages.') }}
{%- endif %}
{%- for message in _msgs %}
    {%- set content = render_content(
        message.content, true, false, message.role == 'assistant'
    )|trim %}
    {%- if message.role == "system" %}
        {%- if not loop.first %}
            {{- raise_exception('System message must be at the beginning.') }}
        {%- endif %}
    {%- elif message.role == "user" %}
        {%- set content = content.split('<|think_off|>') | join('') | trim %}
        {%- set content = content.split('<|think_on|>') | join('') | trim %}
        {{- '<|im_start|>' + message.role + '\n' + content }}
        {{- '<|im_end|>\n' }}
    {%- elif message.role == "assistant" %}
        {%- set reasoning_content = '' %}
        {%- if message.reasoning_content is defined and message.reasoning_content is not none %}
            {%- set reasoning_content = message.reasoning_content | string %}
        {%- elif message.thinking is defined and message.thinking is not none %}
            {%- if message.thinking is string %}
                {%- set reasoning_content = message.thinking %}
            {%- elif message.thinking is iterable and message.thinking is not mapping %}
                {%- set thinking_state = namespace(content='') %}
                {%- for block in message.thinking %}
                    {%- if block is mapping and block.type is defined
                           and block.type == 'thinking'
                           and block.thinking is defined
                           and block.thinking is not none %}
                        {%- if thinking_state.content %}
                            {%- set thinking_state.content = thinking_state.content ~ '\n' %}
                        {%- endif %}
                        {%- set thinking_state.content = thinking_state.content ~ (block.thinking | string) %}
                    {%- elif block is string %}
                        {%- if thinking_state.content %}
                            {%- set thinking_state.content = thinking_state.content ~ '\n' %}
                        {%- endif %}
                        {%- set thinking_state.content = thinking_state.content ~ block %}
                    {%- endif %}
                {%- endfor %}
                {%- set reasoning_content = thinking_state.content %}
            {%- else %}
                {%- set reasoning_content = message.thinking | string %}
            {%- endif %}
        {%- elif message.content is iterable and message.content is not mapping and message.content is not string %}
            {%- set thinking_state = namespace(content='') %}
            {%- for block in message.content %}
                {%- if block is mapping and block.type is defined
                       and block.type == 'thinking'
                       and block.thinking is defined
                       and block.thinking is not none %}
                    {%- if thinking_state.content %}
                        {%- set thinking_state.content = thinking_state.content ~ '\n' %}
                    {%- endif %}
                    {%- set thinking_state.content = thinking_state.content ~ (block.thinking | string) %}
                {%- endif %}
            {%- endfor %}
            {%- set reasoning_content = thinking_state.content %}
        {%- elif content.startswith('<think>') and '</think>' in content %}
            {%- set reasoning_content = content.split('</think>')[0].split('<think>')[-1] | trim %}
            {%- set content = content.split('</think>')[-1].lstrip('\n') %}
        {%- endif %}
        {%- set reasoning_content = reasoning_content|trim %}
        {%- if (_preserve_history or loop.index0 > ns.last_query_index) and reasoning_content %}
            {{- '<|im_start|>' + message.role + '\n<think>\n' + reasoning_content + '\n</think>\n\n' + content }}
        {%- else %}
            {{- '<|im_start|>' + message.role + '\n' + content }}
        {%- endif %}
        {%- if message.tool_calls is defined and message.tool_calls is not none and message.tool_calls %}
            {%- if message.tool_calls is string or message.tool_calls is mapping or message.tool_calls is not iterable %}
                {{- raise_exception('assistant.tool_calls must be an iterable list.') }}
            {%- endif %}
            {%- for tool_call in message.tool_calls %}
                {%- set tc = tool_call.function if tool_call.function is defined else tool_call %}
                {%- if tc.name is not defined or tc.name is none or tc.name is not string or not tc.name %}
                    {{- raise_exception('Every tool call must have a non-empty string name.') }}
                {%- endif %}
                {%- if loop.first and content | trim %}
                    {{- '\n\n' }}
                {%- elif not loop.first %}
                    {{- '\n' }}
                {%- endif %}
                {{- '<tool_call>\n<function=' + tc.name + '>\n' }}
                {%- if tc.arguments is defined and tc.arguments is not none and tc.arguments != '' and tc.arguments != '{}' %}
                    {%- if tc.arguments is string %}
                        {{- raise_exception('XML tool calls require mapping arguments. Normalize JSON-string arguments before applying this template.') }}
                    {%- elif tc.arguments is mapping %}
                        {%- for args_name, args_value in tc.arguments | items %}
                            {{- '<parameter=' + (args_name | string) + '>\n' }}
                            {%- set args_value = args_value | string if args_value is string else args_value | tojson | safe %}
                            {{- args_value }}
                            {{- '\n</parameter>\n' }}
                        {%- endfor %}
                    {%- else %}
                        {{- raise_exception('XML tool-call arguments must be a mapping.') }}
                    {%- endif %}
                {%- endif %}
                {{- '</function>\n</tool_call>' }}
            {%- endfor %}
        {%- endif %}
        {{- '<|im_end|>\n' }}
    {%- elif message.role == "tool" %}
        {%- if loop.previtem and loop.previtem.role != "tool" %}
            {{- '<|im_start|>user' }}
        {%- endif %}
        {{- '\n<tool_response>\n' }}
        {{- content }}
        {{- '\n</tool_response>' }}
        {%- if not loop.last and loop.nextitem.role != "tool" %}
            {{- '<|im_end|>\n' }}
        {%- elif loop.last %}
            {{- '<|im_end|>\n' }}
        {%- endif %}
    {%- else %}
        {{- raise_exception('Unexpected message role.') }}
    {%- endif %}
{%- endfor %}
{#- When the turn ends on tool output, open the thinking by picking up from
    that output in Chinese, so the tokens nearest the generation point are
    Chinese instead of the (often English) tool payload. -#}
{%- set _next_is_tool_followup = _msgs and _msgs | length > 0 and _msgs[-1].role == 'tool' %}
{%- if add_generation_prompt %}
    {{- '<|im_start|>assistant\n' }}
    {%- if not ns_state.thinking %}
        {{- '<think>\n\n</think>\n\n' }}
    {%- else %}
        {{- '<think>\n' }}
        {%- if _reasoning_language in ('zh', 'zh-CN') %}
            {%- if _next_is_tool_followup and _tool_followup_seed %}
                {{- _tool_followup_seed }}
            {%- else %}
                {{- '好的，' }}
            {%- endif %}
        {%- endif %}
    {%- endif %}
{%- endif %}
